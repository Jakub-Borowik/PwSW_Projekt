<?xml version="1.0" encoding="utf-8"?>

<Window
    x:Class="SpotiFlow.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SpotiFlow.ViewModels"
    Title="SpotiFlow">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE8D6;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="SpotiFlow" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Padding="24,4,24,24" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="2">
                        <TextBlock Text="SpotiFlow" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="Lepszy niż Spotify DJ"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Konto Spotify" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBox Header="Client ID"
                                     PlaceholderText="wklej Client ID z developer.spotify.com"
                                     Text="{x:Bind ViewModel.ClientId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Content="Zaloguj się przez Spotify" HorizontalAlignment="Stretch"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Command="{x:Bind ViewModel.LoginCommand}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="8" Height="8" Fill="{x:Bind ViewModel.LoginStatusBrush, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind ViewModel.LoginStatus, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Sterowanie" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}"
                                        Command="{x:Bind ViewModel.StartCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE768;" FontSize="14" />
                                        <TextBlock Text="Start" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" HorizontalAlignment="Stretch"
                                        Command="{x:Bind ViewModel.StopCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE71A;" FontSize="14" />
                                        <TextBlock Text="Stop" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Redirect URI - wpisz w panelu Spotify API"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind ViewModel.RedirectUri}" IsTextSelectionEnabled="True"
                                           FontFamily="Consolas" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="1" Command="{x:Bind ViewModel.CopyRedirectUriCommand}"
                                        ToolTipService.ToolTip="Kopiuj do schowka">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                        <TextBlock Text="{x:Bind ViewModel.CopyButtonText, Mode=OneWay}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="1" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <InfoBar Severity="Error" Title="Monitorowanie wstrzymane"
                         IsOpen="{x:Bind ViewModel.IsErrorOpen, Mode=TwoWay}"
                         Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="20">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Width="148" Height="148" VerticalAlignment="Top">
                            <Border CornerRadius="8" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                <FontIcon Glyph="&#xE8D6;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </Border>
                            <Border CornerRadius="8">
                                <Border.Background>
                                    <ImageBrush ImageSource="{x:Bind ViewModel.NowCover, Mode=OneWay}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                        </Grid>

                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="TERAZ GRA" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.NowTitle, Mode=OneWay}"
                                       Style="{StaticResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind ViewModel.NowArtist, Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />

                            <Grid ColumnSpacing="12" Margin="0,8,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ProgressBar Maximum="1" Value="{x:Bind ViewModel.NowRatio, Mode=OneWay}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.NowRatioText, Mode=OneWay}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </Grid>

                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.NowAttributes, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout MaximumRowsOrColumns="2" ItemsStretch="Fill"
                                                       MinItemWidth="200" MinColumnSpacing="24" MinRowSpacing="6" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AttributeView">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="96" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="36" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Name}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <ProgressBar Grid.Column="1" Maximum="1" Value="{x:Bind Value}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind ValueText}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>

                            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" Margin="0,8,0,0"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Historia" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                    <Button Content="Wyczyść" HorizontalAlignment="Right" Command="{x:Bind ViewModel.ClearHistoryCommand}" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.History}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="8" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:HistoryItem">
                                    <Grid>

                                        <TextBlock Visibility="{x:Bind IsMessage}" Text="{x:Bind MessageText}"
                                                   Foreground="{x:Bind MessageBrush}" Margin="4,2"
                                                   Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />


                                        <Border Visibility="{x:Bind IsTrack}" Style="{StaticResource CardStyle}" Padding="12">
                                            <Grid ColumnSpacing="14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Grid Width="80" Height="80" VerticalAlignment="Top">
                                                    <Border CornerRadius="6" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                                        <FontIcon Glyph="&#xE8D6;" FontSize="24" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                    </Border>
                                                    <Border CornerRadius="6">
                                                        <Border.Background>
                                                            <ImageBrush ImageSource="{x:Bind Cover, Mode=OneWay}" Stretch="UniformToFill" />
                                                        </Border.Background>
                                                    </Border>
                                                </Grid>
                                                <StackPanel Grid.Column="1" Spacing="1">
                                                    <TextBlock Text="{x:Bind Badge, Mode=OneWay}" Foreground="{x:Bind BadgeBrush, Mode=OneWay}"
                                                               Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" IsColorFontEnabled="False" />
                                                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <ItemsRepeater ItemsSource="{x:Bind Attributes, Mode=OneWay}" Margin="0,8,0,0">
                                                        <ItemsRepeater.Layout>
                                                            <UniformGridLayout MaximumRowsOrColumns="4" ItemsStretch="Fill"
                                                                               MinItemWidth="110" MinColumnSpacing="16" MinRowSpacing="6" />
                                                        </ItemsRepeater.Layout>
                                                        <ItemsRepeater.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:AttributeView">
                                                                <StackPanel Spacing="4">
                                                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                                        <Run Text="{x:Bind Name}" />
                                                                        <Run Text="{x:Bind ValueText}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                                    </TextBlock>
                                                                    <ProgressBar Maximum="1" Value="{x:Bind Value}" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsRepeater.ItemTemplate>
                                                    </ItemsRepeater>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
